{% extends 'base.html.twig' %}

{% block title %}Hello OffreController!{% endblock %}

{% block header %}

        <div>Worktogether</div>
            <a  href="../../reservation">Reservation</a>
            <a  href="../../account">Mon compte</a> 
        </div>

{% endblock %}


{% block body %}
<div class="container">
    <h2>Nos offres commerciales</h2>

    <div class="cards-grid">
        {% for o in offre %}
            <div class="card">
                <div class="card-header">
                    <h3>{{ o.getNom ?? 'Offre sans Nom' }}</h3>
                </div>
                <div class="card-body">
                    <p><strong>Nombre d'unités :</strong> {{ o.getNbunit ?? 'N/C' }}</p>
                    <p><strong>Prix mensuel :</strong> {{ o.getPrixMensuel ?? '0' }} €</p>
                    <p><strong>Prix annuel :</strong> {{ o.getPrixAnnuel ?? '0' }} €</p>
                </div>
                <div class="card-footer">
                    <a href="{{ path('app_payment_checkout', {id: o.id}) }}" class="btn btn-primary">Payer cette offre</a>
                </div>
            </div>
        {% else %}
            <p>Aucune offre n'est disponible pour le moment.</p>
        {% endfor %}
    </div>
</div>
{% endblock %}
