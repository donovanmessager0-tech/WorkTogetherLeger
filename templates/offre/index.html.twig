{% extends 'base.html.twig' %}

{% block title %}Hello OffreController!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
<ul>
        {% for o in offre %}
            <li>{{ o.getID ?? 'Offre sans ID' }}</li>
            <li>{{ o.getNom ?? 'Offre sans Nom' }}</li>
            <li>{{ o.getPrixMensuel ?? 'Offre sans Prix Mensuel' }}</li>
            <li>{{ o.getPrixAnnuel ?? 'Offre sans Prix Annuel' }}</li>
            <li>{{ o.getNbunit ?? 'Offre sans nombre d\'unité' }}</li>
        {% else %}
            <li>Aucune offre n'est disponible pour le moment.</li>
        {% endfor %}
    </ul>
</div>
{% endblock %}
