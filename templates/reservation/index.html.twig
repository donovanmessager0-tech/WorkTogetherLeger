{% extends 'base.html.twig' %}

{% block title %}Reservation index{% endblock %}

{% block header %}

        <div>Worktogether</div>
            <a  href="../../unite">Unite</a>
            <a  href="../../offre">Offre</a>
            <a  href="../../account">Mon compte</a> 
            <a href="{{ path('app_logout') }}">Se déconnecter</a>
        </div>

{% endblock %}

{% block body %}
    <h1>Reservation index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Client</th>
                <th>Offre</th>
                <th>Type d'abonnement</th>
                <th>Date de Paiement</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for reservation in reservations %}
            <tr>
                <td>{{ reservation.id }}</td>
                <td>{{ reservation.getClient() }}</td>
                <td>{{ reservation.getOffre() }}</td>
                <td>{{ reservation.getperiod() }}</td>
                <td>{{ reservation.paidAt ? reservation.paidAt|date('d/m/Y H:i') : '-' }}</td>
                <td>
                    <a href="{{ path('app_reservation_show', {'id': reservation.id}) }}">show</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="2">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_reservation_new') }}">Create new</a>
{% endblock %}
