{% extends 'base.html.twig' %}

{% block title %}Unite index{% endblock %}

{% block header %}

        <div>Worktogether</div>
            <a  href="../../reservation">Réservations</a>
            <a  href="../../offre">Offre</a>
            <a  href="../../account">Mon compte</a> 
            <a href="{{ path('app_logout') }}">Se déconnecter</a>
        </div>

{% endblock %}

{% block body %}
    <h1>Unite index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Numero_u</th>
                <th>Statut</th>
                <th>Type de serveur</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for unite in unites %}
            <tr>
                <td>{{ unite.id }}</td>
                <td>{{ unite.numeroU }}</td>
                <td>{{ unite.status ? unite.status.name : '' }}</td>
                <td>{{ unite.type ? unite.type.Name : '' }}</td>
                <td>
                    <a href="{{ path('app_unite_show', {'id': unite.id}) }}">show</a>
                    <a href="{{ path('app_unite_edit', {'id': unite.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_unite_new') }}">Create new</a>
{% endblock %}
